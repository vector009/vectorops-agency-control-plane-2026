# Static frontend (Vercel, Cloudflare Pages, Netlify, etc.). These values are
# intentionally public; never place a service-role or n8n secret in VITE_*.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
VITE_VECTOROPS_API_URL=https://your-project.supabase.co/functions/v1/vectorops-api

# Supabase Edge Function secrets. SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
PUBLIC_APP_URL=https://portal.your-domain.com
ALLOWED_ORIGINS=https://portal.your-domain.com
N8N_EXECUTION_SYNC_LIMIT=50
N8N_EVENT_INGEST_SECRET=replace-with-a-separate-random-webhook-secret
N8N_CRON_SECRET=replace-with-another-random-scheduler-secret

# Optional persistent Express deployment / local connected development.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000

# Server-side n8n control plane. API keys stay in Supabase Vault.
N8N_SYNC_ENABLED=true
N8N_SYNC_INTERVAL_MS=60000
N8N_EXECUTION_SYNC_LIMIT=50
N8N_ALLOW_INSECURE_HTTP=false

# Existing projects may use SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# instead. They remain supported as server-side compatibility fallbacks.

# Optional development-only demo credentials. Local demo mode is disabled in production.
ADMIN_AUTH_PASSWORD=replace-for-local-development
CLIENT_AUTH_PASSWORD=replace-for-local-development
